{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "deploy:mock": "wrangler deploy -c workers/mock-api/wrangler.toml",
    "deploy:limiter": "wrangler deploy -c workers/rate-limiter/wrangler.toml",
    "deploy": "npm run deploy:mock && npm run deploy:limiter",
    "dev:mock": "wrangler dev -c workers/mock-api/wrangler.toml",
    "dev:limiter": "wrangler dev -c workers/rate-limiter/wrangler.toml",
    "test": "bash run-tests.sh",
    "jwt": "node jwt-demo/generate-jwt.js",
    "jwt:keys": "node jwt-demo/generate-keys.js"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.0.0"
  }
}
